{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original skill-movie 566-atom bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "count",
    "atoms"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "role",
          "family",
          "zh",
          "en"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^vfx_term_[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
